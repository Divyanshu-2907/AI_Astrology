---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../../../../i18n/utils';
import HoroscopeInternalLinks from '../../../../components/HoroscopeInternalLinks.astro';
import JsonLdArticle from '../../../../components/JsonLdArticle.astro';
import JsonLdFAQ from '../../../../components/JsonLdFAQ.astro';

// No getStaticPaths or prerender = true because this uses SSR for Llama 3.1

const { sign } = Astro.params;
const lang = getLangFromUrl(Astro.url);

const today = new Date();
const displayDate = today.toLocaleDateString('hi-IN', { month: 'long', year: 'numeric' });
const monthId = `${today.getFullYear()}-${today.getMonth() + 1}`;

import { env } from 'cloudflare:workers';

let contentData: any = null;
let errorMsg = "";

try {
  const cache = env.ASTRO_BLOG_CACHE;
  const ai = env.AI;
  const cacheKey = `horoscope:monthly:hi:${sign}:${monthId}`;
  
  if (cache) {
    let cachedContent = await cache.get(cacheKey);
    
    if (cachedContent) {
      contentData = JSON.parse(cachedContent);
    } else if (ai) {
      const prompt = `Write a monthly astrology horoscope in HINDI for the zodiac sign ${sign} for this month (${displayDate}).
      
      You must output ONLY valid JSON matching this exact structure (all values must be in Hindi):
      {
        "seo_title": "Under 60 chars, include ${sign} and 'मासिक राशिफल'",
        "meta_description": "150-160 chars summary for search engines in Hindi",
        "overview": "4-5 sentences overview of the month specifically for ${sign} in Hindi.",
        "love": "120-150 words about love for the month in Hindi.",
        "career": "120-150 words about career/finance for the month in Hindi.",
        "health": "120-150 words about health/wellness for the month in Hindi.",
        "lucky_number": "A number",
        "lucky_color": "A color in Hindi",
        "faqs": [
          { "question": "इस महीने ${sign} राशि के लिए मुख्य ध्यान क्या होना चाहिए?", "answer": "40-60 words answer in Hindi" },
          { "question": "क्या इस महीने ${sign} राशि के लिए कोई चुनौतियां हैं?", "answer": "40-60 words answer in Hindi" }
        ]
      }`;

      const response = await ai.run('@cf/meta/llama-3.1-8b-instruct-fp8', {
        max_tokens: 3000,
        messages: [
          { role: 'system', content: 'You are an expert astrologer. You only respond in pure JSON format without markdown blocks.' },
          { role: 'user', content: prompt }
        ]
      });
      
      let responseText = response.response;
      responseText = responseText.replace(/```json/g, '').replace(/```/g, '').trim();
      
      contentData = JSON.parse(responseText);
      
      await cache.put(cacheKey, JSON.stringify(contentData), { expirationTtl: 2592000 });
    }
  } else {
    contentData = {
      seo_title: `${sign} मासिक राशिफल: Development Mode`,
      meta_description: "Cloudflare Workers AI and KV are not available in standard local dev mode.",
      overview: "क्लाउडफ्लेयर पर डिप्लॉय करें!",
      love: "डेव मोड प्रेम राशिफल.",
      career: "डेव मोड करियर राशिफल.",
      health: "डेव मोड स्वास्थ्य राशिफल.",
      lucky_number: "7",
      lucky_color: "नीला (Blue)",
      faqs: []
    };
  }
} catch (e) {
  console.error("Error with AI/KV:", e);
  errorMsg = e instanceof Error ? e.message : String(e);
}
---

<BaseLayout 
  title={contentData ? contentData.seo_title : `${sign} मासिक राशिफल ${displayDate} | AI Astrology`}
  description={contentData ? contentData.meta_description : `${sign} राशि के लिए ${displayDate} का मासिक ज्योतिषीय राशिफल पढ़ें।`}
>
  {contentData && (
    <>
      <JsonLdArticle 
        title={contentData.seo_title}
        datePublished={new Date().toISOString()}
        bodyText={`${contentData.overview} ${contentData.love} ${contentData.career} ${contentData.health}`}
      />
      {contentData.faqs && contentData.faqs.length > 0 && (
        <JsonLdFAQ faqs={contentData.faqs} />
      )}
    </>
  )}

  <main class="container mx-auto px-4 pt-32 pb-24">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row gap-8">
      
      <div class="md:w-2/3">
        <a href='/hi/blog' class="inline-flex items-center text-primary hover:text-primary/80 transition-colors mb-8">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          सभी राशियों पर वापस जाएं
        </a>

        {errorMsg ? (
          <div class="glass-card p-8 md:p-12 text-red-400">
            <h2>राशिफल लोड करने में त्रुटि</h2>
            <p>{errorMsg}</p>
          </div>
        ) : contentData ? (
          <article class="glass-card p-8 md:p-12 mb-8">
            <header class="mb-10 border-b border-glass-border pb-8">
              <div class="inline-block bg-primary/20 text-primary px-3 py-1 rounded-full text-sm font-medium mb-4 capitalize">
                {sign} मासिक राशिफल
              </div>
              <h1 class="text-3xl md:text-5xl font-serif text-theme-main mb-4 leading-tight capitalize">
                {sign} मासिक राशिफल
              </h1>
              <p class="text-lg text-theme-muted mb-6">{displayDate}</p>
              
              <div class="flex flex-wrap gap-4 text-sm mt-6">
                <div class="bg-glass-bg border border-glass-border rounded-lg px-4 py-2 text-center">
                  <span class="block text-xs text-theme-muted uppercase tracking-wider mb-1">शुभ अंक</span>
                  <strong class="text-lg text-theme-main">{contentData.lucky_number}</strong>
                </div>
                <div class="bg-glass-bg border border-glass-border rounded-lg px-4 py-2 text-center">
                  <span class="block text-xs text-theme-muted uppercase tracking-wider mb-1">शुभ रंग</span>
                  <strong class="text-lg text-theme-main">{contentData.lucky_color}</strong>
                </div>
              </div>
            </header>

            <div class="prose prose-invert prose-lg max-w-none prose-headings:text-theme-main prose-headings:font-serif prose-p:text-theme-muted prose-li:text-theme-muted prose-a:text-primary hover:prose-a:text-primary/80">
              <h2 class="text-2xl font-serif text-theme-main mb-4">अवलोकन (Overview)</h2>
              <p class="mb-8">{contentData.overview}</p>

              <h2 class="text-2xl font-serif text-theme-main mb-4">प्रेम और संबंध (Love & Relationships)</h2>
              <p class="mb-8">{contentData.love}</p>

              <h2 class="text-2xl font-serif text-theme-main mb-4">करियर और वित्त (Career & Finance)</h2>
              <p class="mb-8">{contentData.career}</p>

              <h2 class="text-2xl font-serif text-theme-main mb-4">स्वास्थ्य (Health & Wellness)</h2>
              <p class="mb-8">{contentData.health}</p>
            </div>
            
            {contentData.faqs && contentData.faqs.length > 0 && (
              <div class="mt-12 pt-8 border-t border-glass-border">
                <h3 class="text-xl font-serif text-theme-main mb-6">अक्सर पूछे जाने वाले प्रश्न (FAQs)</h3>
                <div class="space-y-6">
                  {contentData.faqs.map((faq: any) => (
                    <div>
                      <h4 class="font-medium text-theme-main mb-2">{faq.question}</h4>
                      <p class="text-theme-muted text-sm">{faq.answer}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </article>
        ) : (
          <div class="glass-card p-8 md:p-12 text-theme-muted">
            <p>आपका ब्रह्मांडीय पूर्वानुमान लोड हो रहा है...</p>
          </div>
        )}
      </div>

      <div class="md:w-1/3">
        <HoroscopeInternalLinks sign={sign} date="monthly" lang="hi" />
      </div>
      
    </div>
  </main>
</BaseLayout>

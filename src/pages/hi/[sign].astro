---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { zodiacsHi } from '../../data/zodiacs.hi';

export const prerender = true;

export function getStaticPaths() {
  return zodiacsHi.map(z => ({
    params: { sign: z.id },
    props: { zodiac: z },
  }));
}

const { zodiac } = Astro.props;
---

<ToolLayout 
  title={`${zodiac.name} राशि: अर्थ, लक्षण, प्रेम और करियर`} 
  description={`${zodiac.name} राशि के बारे में अन्वेषण करें। इसके व्यक्तित्व लक्षण, प्रेम अनुकूलता, करियर पथ और ज्योतिष में अर्थ के बारे में जानें।`}
>
  <div class="mb-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center space-x-6">
      <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-primary/20 to-highlight/20 border border-primary/30 flex items-center justify-center text-5xl text-theme-main shadow-[0_0_30px_rgba(79,70,229,0.2)]">
        ♈
      </div>
      <div>
        <h1 class="text-4xl md:text-5xl font-serif text-theme-main mb-2">{zodiac.name} ({zodiac.sanskritName})</h1>
        <div class="flex items-center space-x-4 text-sm text-theme-muted">
          <span class="flex items-center"><span class="w-2 h-2 rounded-full bg-primary mr-2"></span> ज्योतिषीय राशि (Zodiac Sign)</span>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
    <div class="md:col-span-2 space-y-8">
      
      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">परिचय (Introduction)</h2>
        <p class="text-theme-muted leading-relaxed">{zodiac.content.introduction}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">व्यक्तित्व के लक्षण (Personality Traits)</h2>
        <p class="text-theme-muted leading-relaxed">{zodiac.content.personalityTraits}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">तत्व विश्लेषण (Element Analysis)</h2>
        <p class="text-theme-muted leading-relaxed">{zodiac.content.elementAnalysis}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">प्रेम और रिश्ते (Love and Relationships)</h2>
        <p class="text-theme-muted leading-relaxed">{zodiac.content.loveAndRelationships}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">अनुकूलता (Compatibility)</h2>
        <p class="text-theme-muted leading-relaxed">{zodiac.content.compatibilityMatrix}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">करियर और धन (Career and Money)</h2>
        <p class="text-theme-muted leading-relaxed">{zodiac.content.careerAndMoney}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">पौराणिक कथा और प्रतीकवाद (Mythology & Symbolism)</h2>
        <p class="text-theme-muted leading-relaxed">{zodiac.content.mythology}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-6">{zodiac.name} के 3 द्रेष्काण (Decans)</h2>
        <div class="space-y-4">
          {zodiac.content.decans.map((d) => (
            <div class="p-4 rounded-lg bg-glass-border/30 border border-glass-border/50">
              <h3 class="text-lg font-medium text-theme-main mb-1">द्रेष्काण (Decan) {d.decan}</h3>
              <p class="text-theme-muted text-sm">{d.description}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-6">अक्सर पूछे जाने वाले प्रश्न (FAQs)</h2>
        <div class="space-y-6">
          {zodiac.content.faqs.map(faq => (
            <div>
              <h3 class="text-lg font-medium text-theme-main mb-2">{faq.question}</h3>
              <p class="text-theme-muted">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
    
    <div class="space-y-6">
      <div class="glass-card p-6 border-t-4 border-t-secondary">
        <h3 class="text-lg font-serif text-theme-main mb-4">राशि का विवरण</h3>
        <ul class="space-y-4">
          <li class="flex justify-between items-center border-b border-glass-border pb-2">
            <span class="text-theme-muted text-sm">शासक ग्रह (Ruling Planet)</span>
            <span class="text-theme-main font-medium text-right">{zodiac.rulingPlanet}</span>
          </li>
          <li class="flex justify-between items-center border-b border-glass-border pb-2">
            <span class="text-theme-muted text-sm">तत्व (Element)</span>
            <span class="text-theme-main font-medium text-right">{zodiac.element}</span>
          </li>
          <li class="flex justify-between items-center border-b border-glass-border pb-2">
            <span class="text-theme-muted text-sm">गुण (Quality)</span>
            <span class="text-theme-main font-medium text-right">{zodiac.quality}</span>
          </li>
          <li class="flex justify-between items-center">
            <span class="text-theme-muted text-sm">प्रतीक (Symbol)</span>
            <span class="text-theme-main font-medium text-right">{zodiac.symbol}</span>
          </li>
        </ul>
      </div>
      
      <div class="glass-card p-6">
        <h3 class="text-lg font-serif text-theme-main mb-4">अन्य राशियों के बारे में जानें</h3>
        <div class="space-y-3 h-[400px] overflow-y-auto pr-2 custom-scrollbar">
          {zodiacsHi.filter(z => z.id !== zodiac.id).map(z => (
            <a href={`/hi/${z.id}`} class="block p-3 rounded-lg bg-glass-border/50 hover:bg-glass-border transition-colors">
              <div class="font-medium text-theme-main">{z.name}</div>
              <div class="text-xs text-theme-muted mt-1">{z.symbol}</div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</ToolLayout>
<style>
.custom-scrollbar::-webkit-scrollbar {
  width: 6px;
}
.custom-scrollbar::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.02);
  border-radius: 4px;
}
.custom-scrollbar::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4px;
}
.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.2);
}
</style>

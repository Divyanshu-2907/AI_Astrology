---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { housesHi } from '../../../data/houses.hi';

export const prerender = true;

export function getStaticPaths() {
  return housesHi.map(h => ({
    params: { house: h.id },
    props: { house: h },
  }));
}

const { house } = Astro.props;
---

<ToolLayout 
  title={house.title} 
  description={house.description}
>
  <div class="mb-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center space-x-6">
      <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-primary/20 to-highlight/20 border border-primary/30 flex items-center justify-center text-5xl text-theme-main shadow-[0_0_30px_rgba(79,70,229,0.2)]">
        🏛️
      </div>
      <div>
        <h1 class="text-4xl md:text-5xl font-serif text-theme-main mb-2">{house.name} ({house.sanskritName})</h1>
        <div class="flex items-center space-x-4 text-sm text-theme-muted">
          <span class="flex items-center"><span class="w-2 h-2 rounded-full bg-primary mr-2"></span> ज्योतिषीय भाव (Astrological House)</span>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
    <div class="md:col-span-2 space-y-8">
      
      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">परिचय (Introduction)</h2>
        <p class="text-theme-muted leading-relaxed">{house.content.introduction}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">{house.name} क्या दर्शाता है</h2>
        <p class="text-theme-muted leading-relaxed">{house.content.whatItRepresents}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">वैदिक बनाम पश्चिमी दृष्टिकोण (Vedic vs Western)</h2>
        <p class="text-theme-muted leading-relaxed">{house.content.vedicVsWestern}</p>
      </div>

      <div class="glass-card p-8 border-l-4 border-l-primary">
        <h2 class="text-2xl font-serif text-theme-main mb-6">{house.name} में ग्रहों का प्रभाव</h2>
        <div class="space-y-6">
          {house.content.planetsInHouse.map(p => (
            <div class="bg-glass-border/30 p-4 rounded-xl">
              <h3 class="text-lg font-medium text-theme-main mb-2">{p.planet}</h3>
              <p class="text-theme-muted text-sm leading-relaxed">{p.influence}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-6">अक्सर पूछे जाने वाले प्रश्न (FAQs)</h2>
        <div class="space-y-6">
          {house.content.faqs.map(faq => (
            <div>
              <h3 class="text-lg font-medium text-theme-main mb-2">{faq.question}</h3>
              <p class="text-theme-muted">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
    
    <div class="space-y-6">
      <div class="glass-card p-6 border-t-4 border-t-secondary">
        <h3 class="text-lg font-serif text-theme-main mb-4">भाव का विवरण</h3>
        <ul class="space-y-4">
          <li class="flex justify-between items-center border-b border-glass-border pb-2">
            <span class="text-theme-muted text-sm">मुख्य विषय</span>
            <span class="text-theme-main font-medium text-right max-w-[60%]">{house.content.keyThemes}</span>
          </li>
          <li class="flex justify-between items-center">
            <span class="text-theme-muted text-sm">कारक ग्रह (Significator)</span>
            <span class="text-theme-main font-medium">{house.significator}</span>
          </li>
        </ul>
      </div>
      
      <div class="glass-card p-6">
        <h3 class="text-lg font-serif text-theme-main mb-4">अन्य भावों के बारे में जानें</h3>
        <div class="space-y-3">
          {housesHi.filter(h => h.id !== house.id).slice(0, 4).map(h => (
            <a href={`/hi/houses/${h.id}`} class="block p-3 rounded-lg bg-glass-border/50 hover:bg-glass-border transition-colors">
              <div class="font-medium text-theme-main">{h.name}</div>
              <div class="text-xs text-theme-muted mt-1">गाइड पढ़ें →</div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

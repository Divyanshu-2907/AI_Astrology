---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => {
    return data.lang === 'hi';
  });
  return blogEntries.map(entry => ({
    params: { slug: entry.slug.replace('hi/', '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout 
  title={`${entry.data.title} | AI Astrology Blog`}
  description={entry.data.description}
>
  <article class="max-w-3xl mx-auto px-4 py-16">
    <div class="mb-12 text-center">
      <div class="flex items-center justify-center gap-4 mb-6">
        <span class="text-sm text-primary uppercase tracking-wider font-semibold">लेख</span>
        <span class="text-sm text-theme-muted">{entry.data.pubDate.toLocaleDateString('hi-IN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-serif text-theme-main mb-6 leading-tight">{entry.data.title}</h1>
      <div class="text-theme-muted flex items-center justify-center gap-2">
        <span class="w-8 h-8 rounded-full bg-glass-border flex items-center justify-center text-sm">✍️</span>
        <span class="font-medium">{entry.data.author}</span>
      </div>
    </div>

    <div class="glass-card p-8 md:p-12 prose prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-theme-main prose-a:text-primary hover:prose-a:text-highlight transition-colors">
      <Content />
    </div>
  </article>
</BaseLayout>

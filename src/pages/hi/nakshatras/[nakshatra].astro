---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { nakshatrasHi } from '../../../data/nakshatras.hi';

export const prerender = true;

export function getStaticPaths() {
  return nakshatrasHi.map(n => ({
    params: { nakshatra: n.id },
    props: { nakshatra: n },
  }));
}

const { nakshatra } = Astro.props;
---

<ToolLayout 
  title={`${nakshatra.name} नक्षत्र ज्योतिष में: अर्थ, लक्षण और करियर`} 
  description={`${nakshatra.name} नक्षत्र के बारे में अन्वेषण करें। इसके अर्थ, शासक देवता, व्यक्तित्व लक्षण और करियर के बारे में जानें।`}
>
  <div class="mb-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center space-x-6">
      <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-primary/20 to-highlight/20 border border-primary/30 flex items-center justify-center text-5xl text-theme-main shadow-[0_0_30px_rgba(79,70,229,0.2)]">
        ✨
      </div>
      <div>
        <h1 class="text-4xl md:text-5xl font-serif text-theme-main mb-2">{nakshatra.name} नक्षत्र</h1>
        <div class="flex items-center space-x-4 text-sm text-theme-muted">
          <span class="flex items-center"><span class="w-2 h-2 rounded-full bg-primary mr-2"></span> {nakshatra.meaning}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
    <div class="md:col-span-2 space-y-8">
      
      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">परिचय (Introduction)</h2>
        <p class="text-theme-muted leading-relaxed">{nakshatra.content.introduction}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">व्यक्तित्व के लक्षण (Personality Traits)</h2>
        <p class="text-theme-muted leading-relaxed">{nakshatra.content.personalityTraits}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">करियर (Career Interests)</h2>
        <p class="text-theme-muted leading-relaxed">{nakshatra.content.careerInterests}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">नकारात्मक पक्ष (Shadow Side)</h2>
        <p class="text-theme-muted leading-relaxed">{nakshatra.content.shadowSide}</p>
      </div>

      <div class="glass-card p-8 border-l-4 border-l-primary">
        <h2 class="text-2xl font-serif text-theme-main mb-6">चार पद (The Four Padas)</h2>
        <div class="space-y-6">
          {nakshatra.content.fourPadas.map(pada => (
            <div class="bg-glass-border/30 p-4 rounded-xl">
              <h3 class="text-lg font-medium text-theme-main mb-2">पद {pada.pada || (nakshatra.content.fourPadas.indexOf(pada) + 1)}</h3>
              <p class="text-theme-muted text-sm leading-relaxed">{pada.description}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-4">अनुकूलता (Compatibility)</h2>
        <p class="text-theme-muted leading-relaxed">{nakshatra.content.compatibility}</p>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-6">अक्सर पूछे जाने वाले प्रश्न (FAQs)</h2>
        <div class="space-y-6">
          {nakshatra.content.faqs.map(faq => (
            <div>
              <h3 class="text-lg font-medium text-theme-main mb-2">{faq.question}</h3>
              <p class="text-theme-muted">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
    
    <div class="space-y-6">
      <div class="glass-card p-6 border-t-4 border-t-secondary">
        <h3 class="text-lg font-serif text-theme-main mb-4">नक्षत्र का विवरण</h3>
        <ul class="space-y-4">
          <li class="flex justify-between items-center border-b border-glass-border pb-2">
            <span class="text-theme-muted text-sm">शासक ग्रह (Ruling Planet)</span>
            <span class="text-theme-main font-medium text-right">{nakshatra.rulingPlanet}</span>
          </li>
          <li class="flex justify-between items-center border-b border-glass-border pb-2">
            <span class="text-theme-muted text-sm">देवता (Deity)</span>
            <span class="text-theme-main font-medium text-right max-w-[50%]">{nakshatra.deity}</span>
          </li>
          <li class="flex justify-between items-center border-b border-glass-border pb-2">
            <span class="text-theme-muted text-sm">प्रतीक (Symbol)</span>
            <span class="text-theme-main font-medium text-right max-w-[50%]">{nakshatra.symbol}</span>
          </li>
          <li class="flex justify-between items-center">
            <span class="text-theme-muted text-sm">राशि विस्तार (Zodiac Span)</span>
            <span class="text-theme-main font-medium text-right max-w-[60%] text-xs">{nakshatra.zodiacSign}</span>
          </li>
        </ul>
      </div>
      
      <div class="glass-card p-6">
        <h3 class="text-lg font-serif text-theme-main mb-4">अन्य नक्षत्रों के बारे में जानें</h3>
        <div class="space-y-3 h-[400px] overflow-y-auto pr-2 custom-scrollbar">
          {nakshatrasHi.filter(n => n.id !== nakshatra.id).map(n => (
            <a href={`/hi/nakshatras/${n.id}`} class="block p-3 rounded-lg bg-glass-border/50 hover:bg-glass-border transition-colors">
              <div class="font-medium text-theme-main">{n.name}</div>
              <div class="text-xs text-theme-muted mt-1">{n.meaning}</div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</ToolLayout>
<style>
.custom-scrollbar::-webkit-scrollbar {
  width: 6px;
}
.custom-scrollbar::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.02);
  border-radius: 4px;
}
.custom-scrollbar::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4px;
}
.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.2);
}
</style>

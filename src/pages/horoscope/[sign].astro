---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { generateHoroscope } from '../../lib/horoscope-gen';

const { sign } = Astro.params;
const period = (Astro.url.searchParams.get('period') as 'today' | 'weekly' | 'monthly') || 'today';

const signs = [
  { sign: 'aries', name: 'Aries', glyph: '♈', element: 'Fire', planet: 'Mars' },
  { sign: 'taurus', name: 'Taurus', glyph: '♉', element: 'Earth', planet: 'Venus' },
  { sign: 'gemini', name: 'Gemini', glyph: '♊', element: 'Air', planet: 'Mercury' },
  { sign: 'cancer', name: 'Cancer', glyph: '♋', element: 'Water', planet: 'Moon' },
  { sign: 'leo', name: 'Leo', glyph: '♌', element: 'Fire', planet: 'Sun' },
  { sign: 'virgo', name: 'Virgo', glyph: '♍', element: 'Earth', planet: 'Mercury' },
  { sign: 'libra', name: 'Libra', glyph: '♎', element: 'Air', planet: 'Venus' },
  { sign: 'scorpio', name: 'Scorpio', glyph: '♏', element: 'Water', planet: 'Pluto/Mars' },
  { sign: 'sagittarius', name: 'Sagittarius', glyph: '♐', element: 'Fire', planet: 'Jupiter' },
  { sign: 'capricorn', name: 'Capricorn', glyph: '♑', element: 'Earth', planet: 'Saturn' },
  { sign: 'aquarius', name: 'Aquarius', glyph: '♒', element: 'Air', planet: 'Uranus/Saturn' },
  { sign: 'pisces', name: 'Pisces', glyph: '♓', element: 'Water', planet: 'Neptune/Jupiter' }
];

const signData = signs.find(s => s.sign === sign) || signs[0];
const { name, glyph, element, planet } = signData;

// Generate horoscope dynamically based on the requested period!
const horoscopeText = await generateHoroscope(name, period);
const periodDisplay = period === 'today' ? 'Daily' : period.charAt(0).toUpperCase() + period.slice(1);
const today = new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

const lucky = {
  number: Math.floor(Math.random() * 99) + 1,
  color: ["Crimson", "Azure", "Emerald", "Gold", "Violet", "Silver", "Indigo"][Math.floor(Math.random() * 7)],
  time: ["10:00 AM", "2:30 PM", "6:15 PM", "8:45 PM", "11:20 AM"][Math.floor(Math.random() * 5)]
};
---

<ToolLayout 
  title={`${name} Horoscope Today — Daily, Weekly & Monthly | AI Astrology`} 
  description={`Read your free daily ${name} horoscope for today. Discover insights about love, career, and life for the ${name} zodiac sign.`}
>
  
  <div class="mb-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center space-x-6">
      <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-primary/20 to-highlight/20 border border-primary/30 flex items-center justify-center text-5xl text-theme-main shadow-[0_0_30px_rgba(79,70,229,0.2)]">
        {glyph}
      </div>
      <div>
        <h1 class="text-4xl md:text-5xl font-serif text-theme-main mb-2">{name}</h1>
        <div class="flex items-center space-x-4 text-sm text-theme-muted">
          <span class="flex items-center"><span class="w-2 h-2 rounded-full bg-primary mr-2"></span> {element}</span>
          <span class="flex items-center"><span class="w-2 h-2 rounded-full bg-secondary mr-2"></span> {planet}</span>
        </div>
      </div>
    </div>
    
    <div class="text-right">
      <div class="text-primary font-medium mb-1">{today}</div>
      <button class="btn-secondary text-sm py-1.5 px-3" onclick="if(navigator.share) navigator.share({title: document.title, url: window.location.href})">
        <svg class="w-4 h-4 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-5.368m0 5.368l5.657 5.657m-5.657-5.657l5.657-5.657m0 11.314a3 3 0 105.368-5.368 3 3 0 00-5.368 5.368zm0-11.314a3 3 0 105.368 5.368 3 3 0 00-5.368-5.368z"></path></svg>
        Share
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
    <div class="md:col-span-2">
      <div class="glass-card p-8">
        <h2 class="text-2xl font-serif text-theme-main mb-6 flex items-center">
          <span class="bg-primary/20 p-2 rounded-lg mr-3 text-primary">✨</span> {periodDisplay} Reading
        </h2>
        
        <div class="prose prose-invert max-w-none text-theme-muted">
          {horoscopeText.split('\n\n').map(paragraph => (
            <p class="mb-4 leading-relaxed">{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
    
    <div class="space-y-6">
      <div class="glass-card p-6 border-t-4 border-t-secondary">
        <h3 class="text-lg font-serif text-theme-main mb-4">Daily Fortunes</h3>
        <ul class="space-y-4">
          <li class="flex justify-between items-center border-b border-glass-border pb-2">
            <span class="text-theme-muted text-sm">Lucky Number</span>
            <span class="text-theme-main font-medium">{lucky.number}</span>
          </li>
          <li class="flex justify-between items-center border-b border-glass-border pb-2">
            <span class="text-theme-muted text-sm">Lucky Color</span>
            <span class="text-theme-main font-medium">{lucky.color}</span>
          </li>
          <li class="flex justify-between items-center">
            <span class="text-theme-muted text-sm">Auspicious Time</span>
            <span class="text-theme-main font-medium">{lucky.time}</span>
          </li>
        </ul>
      </div>

      <div class="glass-card p-6">
        <h3 class="text-lg font-serif text-theme-main mb-2">Check Compatibility</h3>
        <p class="text-sm text-theme-muted mb-4">Find out how {name} matches with other signs in love and friendship.</p>
        <a href="/compatibility" class="btn-primary w-full text-center text-sm py-2">Check Compatibility</a>
      </div>
    </div>
  </div>

  <div class="prose prose-invert max-w-none glass-card p-8">
    <h2 class="text-2xl font-serif mb-4 text-theme-main">About the {name} Zodiac Sign</h2>
    <p class="text-theme-muted text-sm leading-relaxed mb-4">
      {name}, represented by the {glyph} symbol, is a {element} sign ruled by {planet}. 
      Known for their unique traits and energy, individuals born under this sign bring a distinct flavor to the zodiac wheel.
      Understanding your core astrological profile helps you navigate the daily cosmic weather more effectively.
    </p>
    <p class="text-theme-muted text-sm leading-relaxed">
      Check back daily for your updated {name} horoscope, or upgrade to a premium plan to generate a full Kundali and get deeply personalized AI astrological insights based on your exact birth time.
    </p>
  </div>

</ToolLayout>

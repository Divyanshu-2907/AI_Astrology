---
import BaseLayout from '../../layouts/BaseLayout.astro';

import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const { cookies } = Astro;
if (cookies.has("sb-access-token") && cookies.has("sb-refresh-token")) {
  return Astro.redirect(lang === 'hi' ? "/hi/dashboard" : "/dashboard");
}
---

<BaseLayout 
  title={lang === 'hi' ? "लॉगिन | AI Astrology" : "Login | AI Astrology"} 
  description={lang === 'hi' ? "अपने एआई एस्ट्रोलॉजी खाते में लॉग इन करें।" : "Log in to your AI Astrology account."}
>
  <div class="max-w-md mx-auto px-4 py-20" id="login-container" data-lang={lang}>
    <div class="glass-card p-8 text-center">
      <h1 class="text-3xl font-serif text-theme-main mb-2">{lang === 'hi' ? 'वापसी पर स्वागत है' : 'Welcome Back'}</h1>
      <p class="text-theme-muted mb-8 text-sm">{lang === 'hi' ? 'अपने ब्रह्मांडीय डैशबोर्ड तक पहुंचने के लिए लॉग इन करें।' : 'Log in to access your cosmic dashboard.'}</p>

      <button id="google-login" class="w-full bg-white text-gray-900 font-medium px-4 py-3 rounded-lg mb-6 flex items-center justify-center hover:bg-gray-100 transition-colors">
        <svg class="w-5 h-5 mr-3" viewBox="0 0 24 24">
          <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
        </svg>
        {lang === 'hi' ? 'Google के साथ जारी रखें' : 'Continue with Google'}
      </button>

      <div class="relative flex items-center justify-center mb-6">
        <div class="border-t border-glass-border w-full absolute"></div>
        <span class="bg-background px-3 text-xs text-gray-500 relative z-10">{lang === 'hi' ? 'या' : 'OR'}</span>
      </div>

      <form id="login-form" class="space-y-4">
        <div>
          <input type="email" id="email" required placeholder={lang === 'hi' ? 'ईमेल पता' : 'Email Address'} class="w-full bg-glass-bg border border-glass-border rounded-lg px-4 py-3 text-theme-main focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
        </div>
        <div>
          <input type="password" id="password" required placeholder={lang === 'hi' ? 'पासवर्ड' : 'Password'} class="w-full bg-glass-bg border border-glass-border rounded-lg px-4 py-3 text-theme-main focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
        </div>
        <button type="submit" class="btn-primary w-full py-3">{lang === 'hi' ? 'लॉग इन करें' : 'Log In'}</button>
      </form>
      
      <p id="error-msg" class="text-rose-400 text-sm mt-4 hidden"></p>

      <p class="text-theme-muted text-sm mt-8">
        {lang === 'hi' ? 'खाता नहीं है?' : "Don't have an account?"} <a href={lang === 'hi' ? '/hi/auth/signup' : '/auth/signup'} class="text-primary hover:underline">{lang === 'hi' ? 'साइन अप करें' : 'Sign up'}</a>
      </p>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    const loginForm = document.getElementById('login-form');
    const googleLoginBtn = document.getElementById('google-login');
    const errorMsg = document.getElementById('error-msg');
    const container = document.getElementById('login-container');
    const lang = container?.dataset.lang || 'en';

    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        errorMsg!.textContent = error.message;
        errorMsg!.classList.remove('hidden');
        return;
      }

      if (data.session) {
        setCookiesAndRedirect(data.session);
      }
    });

    googleLoginBtn?.addEventListener('click', async () => {
      const { data, error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: {
          redirectTo: `${window.location.origin}${lang === 'hi' ? '/hi' : ''}/auth/callback`,
        }
      });
      if (error) {
        errorMsg!.textContent = error.message;
        errorMsg!.classList.remove('hidden');
      }
    });

    function setCookiesAndRedirect(session: any) {
      document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=${session.expires_in}; SameSite=Lax; secure`;
      document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=${session.expires_in}; SameSite=Lax; secure`;
      
      const urlParams = new URLSearchParams(window.location.search);
      const next = urlParams.get('next') || (lang === 'hi' ? '/hi/dashboard' : '/dashboard');
      window.location.href = next;
    }
  </script>
</BaseLayout>

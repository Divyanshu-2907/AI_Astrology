  { sign: 'Scorpio', dates: 'Oct 23 - Nov 21', glyph: '♏' },
  { sign: 'Sagittarius', dates: 'Nov 22 - Dec 21', glyph: '♐' },
  { sign: 'Capricorn', dates: 'Dec 22 - Jan 19', glyph: '♑' },
  { sign: 'Aquarius', dates: 'Jan 20 - Feb 18', glyph: '♒' },
  { sign: 'Pisces', dates: 'Feb 19 - Mar 20', glyph: '♓' }
];

const faqs = [

      <div class="space-y-6">
        {faqs.map(faq => (
          <div>
            <h4 class="faq-question text-lg font-medium text-theme-main mb-2">{faq.question}</h4>
            <p class="faq-answer text-theme-muted text-sm">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <FaqJsonLd faqs={faqs} />
</BaseLayout>

---
import PremiumLayout from '../../layouts/PremiumLayout.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
let matchResult = null;

if (Astro.request.method === 'POST') {
    // Generate mock result for demonstration
    matchResult = lang === 'hi' ? {
        total: 28,
        max: 36,
        verdict: "उत्कृष्ट मेल! यह संयोजन गहरे आध्यात्मिक और मानसिक संरेखण के साथ मजबूत दीर्घकालिक क्षमता दिखाता है।",
        factors: [
            { name: "वर्ण", score: 1, max: 1, desc: "आध्यात्मिक अनुकूलता" },
            { name: "वश्य", score: 2, max: 2, desc: "प्रभुत्व और आकर्षण" },
            { name: "तारा", score: 1.5, max: 3, desc: "भाग्य अनुकूलता" },
            { name: "योनि", score: 4, max: 4, desc: "प्रकृति और वृत्ति" },
            { name: "ग्रह मैत्री", score: 4.5, max: 5, desc: "मानसिक अनुकूलता" },
            { name: "गण", score: 6, max: 6, desc: "स्वभाव" },
            { name: "भकूट", score: 1, max: 7, desc: "प्रेम और भावनात्मक सद्भाव" },
            { name: "नाड़ी", score: 8, max: 8, desc: "स्वास्थ्य और संतान" }
        ],
        doshas: [
            { name: "मंगल दोष", status: "कोई दोष मौजूद नहीं।" },
            { name: "रज्जु दोष", status: "स्पष्ट। सुरक्षित संयोजन।" }
        ]
    } : {
        total: 28,
        max: 36,
        verdict: "Excellent Match! This combination shows strong long-term potential with deep spiritual and mental alignment.",
        factors: [
            { name: "Varna", score: 1, max: 1, desc: "Spiritual compatibility" },
            { name: "Vashya", score: 2, max: 2, desc: "Dominance and attraction" },
            { name: "Tara", score: 1.5, max: 3, desc: "Destiny compatibility" },
            { name: "Yoni", score: 4, max: 4, desc: "Nature and instinct" },
            { name: "Graha Maitri", score: 4.5, max: 5, desc: "Mental compatibility" },
            { name: "Gana", score: 6, max: 6, desc: "Temperament" },
            { name: "Bhakoot", score: 1, max: 7, desc: "Love and emotional harmony" },
            { name: "Nadi", score: 8, max: 8, desc: "Health and progeny" }
        ],
        doshas: [
            { name: "Mangal Dosha", status: "No affliction present." },
            { name: "Rajju Dosha", status: "Clear. Safe combination." }
        ]
    };
}
---

<PremiumLayout 
  title={lang === 'hi' ? "कुंडली मिलान | AI Astrology" : "Kundali Matching | AI Astrology"} 
  description={lang === 'hi' ? "वैदिक कुंडली मिलान (अष्टकूट मिलान)।" : "Vedic Kundali Matching (Ashtakoot Milan)."}
>
  
  <div class="text-center mb-12">
    <div class="inline-flex items-center bg-amber-500/10 text-amber-500 px-4 py-1 rounded-full text-sm font-medium mb-4 border border-amber-500/30">
      <span class="text-[10px] border border-amber-500 px-1 py-[1px] rounded-[3px] mr-2 uppercase tracking-wider font-bold">PRO</span> {lang === 'hi' ? 'प्रीमियम फ़ीचर' : 'Premium Feature'}
    </div>
    <h1 class="text-4xl md:text-5xl font-serif text-theme-main mb-4">{lang === 'hi' ? 'कुंडली मिलान' : 'Kundali Matching'}</h1>
    <p class="text-xl text-theme-muted max-w-2xl mx-auto font-light">
      {lang === 'hi' ? 'विस्तृत संबंध अनुकूलता के लिए अष्टकूट गुण मिलान।' : 'Ashtakoot Guna Milan for detailed relationship compatibility.'}
    </p>
  </div>

  {!matchResult ? (
      <div class="glass-card p-8 md:p-10 max-w-4xl mx-auto">
        <form method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <!-- Person 1 -->
            <div class="space-y-4">
                <h3 class="text-xl font-serif text-primary border-b border-glass-border pb-2 mb-4">{lang === 'hi' ? 'व्यक्ति 1 विवरण' : 'Person 1 Details'}</h3>
                <div>
                    <label class="block text-sm text-theme-muted mb-1">{lang === 'hi' ? 'नाम' : 'Name'}</label>
                    <input type="text" required class="w-full bg-background/50 border border-glass-border rounded-lg px-4 py-2 text-theme-main text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none">
                </div>
                <div>
                    <label class="block text-sm text-theme-muted mb-1">{lang === 'hi' ? 'जन्म की तारीख' : 'Date of Birth'}</label>
                    <div class="relative">
                      <input type="date" required class="flatpickr-date w-full bg-background/50 border border-glass-border rounded-lg pl-4 pr-10 py-2 text-theme-main text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none [color-scheme:dark]">
                      <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-theme-muted">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                      </div>
                    </div>
                </div>
                <div>
                    <label class="block text-sm text-theme-muted mb-1">{lang === 'hi' ? 'जन्म का समय' : 'Time of Birth'}</label>
                    <div class="relative">
                      <input type="time" required class="flatpickr-time w-full bg-background/50 border border-glass-border rounded-lg pl-4 pr-10 py-2 text-theme-main text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none [color-scheme:dark]">
                      <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-theme-muted">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                      </div>
                    </div>
                </div>
                <div>
                    <label class="block text-sm text-theme-muted mb-1">{lang === 'hi' ? 'जन्म स्थान' : 'Place of Birth'}</label>
                    <input type="text" required class="w-full bg-background/50 border border-glass-border rounded-lg px-4 py-2 text-theme-main text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none">
                </div>
            </div>
            
            <!-- Person 2 -->
            <div class="space-y-4">
                <h3 class="text-xl font-serif text-secondary border-b border-glass-border pb-2 mb-4">{lang === 'hi' ? 'व्यक्ति 2 विवरण' : 'Person 2 Details'}</h3>
                <div>
                    <label class="block text-sm text-theme-muted mb-1">{lang === 'hi' ? 'नाम' : 'Name'}</label>
                    <input type="text" required class="w-full bg-background/50 border border-glass-border rounded-lg px-4 py-2 text-theme-main text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none">
                </div>
                <div>
                    <label class="block text-sm text-theme-muted mb-1">{lang === 'hi' ? 'जन्म की तारीख' : 'Date of Birth'}</label>
                    <div class="relative">
                      <input type="date" required class="flatpickr-date w-full bg-background/50 border border-glass-border rounded-lg pl-4 pr-10 py-2 text-theme-main text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none [color-scheme:dark]">
                      <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-theme-muted">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                      </div>
                    </div>
                </div>
                <div>
                    <label class="block text-sm text-theme-muted mb-1">{lang === 'hi' ? 'जन्म का समय' : 'Time of Birth'}</label>
                    <div class="relative">
                      <input type="time" required class="flatpickr-time w-full bg-background/50 border border-glass-border rounded-lg pl-4 pr-10 py-2 text-theme-main text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none [color-scheme:dark]">
                      <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-theme-muted">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                      </div>
                    </div>
                </div>
                <div>
                    <label class="block text-sm text-theme-muted mb-1">{lang === 'hi' ? 'जन्म स्थान' : 'Place of Birth'}</label>
                    <input type="text" required class="w-full bg-background/50 border border-glass-border rounded-lg px-4 py-2 text-theme-main text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none">
                </div>
            </div>
            
            <div class="md:col-span-2 text-center mt-4">
                <button type="submit" class="btn-primary px-12 py-3 text-lg">{lang === 'hi' ? 'मेल की गणना करें' : 'Calculate Match'}</button>
            </div>
        </form>
      </div>
  ) : (
      <div class="max-w-4xl mx-auto space-y-8">
          
          <div class="glass-card p-10 text-center relative overflow-hidden border-2 border-primary/50 shadow-[0_0_30px_rgba(79,70,229,0.2)]">
              <h2 class="text-xl font-serif text-theme-muted mb-2">{lang === 'hi' ? 'कुल गुण मिलान स्कोर' : 'Total Guna Milan Score'}</h2>
              <div class="text-7xl font-bold text-theme-main mb-6">
                  <span class="text-primary">{matchResult.total}</span><span class="text-3xl text-gray-500">/{matchResult.max}</span>
              </div>
              <p class="text-lg text-emerald-400 font-medium max-w-2xl mx-auto">{matchResult.verdict}</p>
          </div>
          
          <div class="glass-card p-8">
              <h3 class="text-2xl font-serif text-theme-main mb-6 border-b border-glass-border pb-4">{lang === 'hi' ? 'अष्टकूट विश्लेषण' : 'Ashtakoot Breakdown'}</h3>
              <div class="space-y-4">
                  {matchResult.factors.map(f => {
                      // Calculate percentage for visual bar
                      const pct = (f.score / f.max) * 100;
                      let color = "bg-emerald-500";
                      if (pct < 40) color = "bg-rose-500";
                      else if (pct < 70) color = "bg-yellow-500";
                      
                      return (
                          <div class="flex items-center justify-between group">
                              <div class="w-1/3">
                                  <div class="text-theme-main font-medium">{f.name}</div>
                                  <div class="text-xs text-gray-500">{f.desc}</div>
                              </div>
                              <div class="w-1/2 px-4">
                                  <div class="h-2 w-full bg-background rounded-full overflow-hidden border border-glass-border">
                                      <div class={`h-full rounded-full ${color} transition-all duration-1000`} style={`width: ${pct}%`}></div>
                                  </div>
                              </div>
                              <div class="w-1/6 text-right font-serif text-lg">
                                  <span class="text-theme-main">{f.score}</span><span class="text-gray-500 text-sm">/{f.max}</span>
                              </div>
                          </div>
                      );
                  })}
              </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {matchResult.doshas.map(d => (
                  <div class="glass-card p-6 border-l-4 border-l-secondary">
                      <h4 class="text-lg font-serif text-theme-main mb-2">{d.name}</h4>
                      <p class="text-sm text-theme-muted">{d.status}</p>
                  </div>
              ))}
          </div>
          
          <div class="text-center mt-8">
              <a href={lang === 'hi' ? '/hi/kundali-matching' : '/kundali-matching'} class="btn-secondary">{lang === 'hi' ? 'एक और मेल जांचें' : 'Check Another Match'}</a>
          </div>
      </div>
  )}

</PremiumLayout>

---
interface Props {
  slot?: string;
  format?: string;
}

const { slot = import.meta.env.PUBLIC_ADSENSE_SLOT_ID || 'XXXXXXXXXX', format = 'auto' } = Astro.props;
const isDev = import.meta.env.DEV;
const clientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || 'ca-pub-XXXXXXXXXX';
---

{isDev ? (
  <div class="my-4 p-4 border-2 border-dashed border-gray-600/50 rounded-lg text-center text-gray-500 bg-background flex flex-col items-center justify-center min-h-[100px]">
    <span class="text-xs uppercase tracking-widest font-bold text-theme-muted mb-1">AdSense Placement</span>
    <span class="text-xs opacity-50">Will appear here in production</span>
  </div>
) : (
  <div class="ad-container my-4 text-center overflow-hidden">
    <ins class="adsbygoogle"
      style="display:block"
      data-ad-client={clientId}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive="true"></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}

